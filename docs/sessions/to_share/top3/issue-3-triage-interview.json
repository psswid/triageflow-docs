>flush();\n95:     }\n96: \n97:     /**\n98:      * Scan the conversation history backwards for the most recent\n99:      * answer entry and return its content, or null if none found.\n100:      *\n101:      * @param array<int, array{type: string, content: string, timestamp: string}> $history\n102:      */\n103:     private function extractLastAnswer(array $history): ?string\n104:     {\n105:         for ($i = count($history) - 1; $i >= 0; $i--) {\n106:             if ($history[$i]['type'] === 'answer') {\n107:                 return $history[$i]['content'];\n108:             }\n109:         }\n110: \n111:         return null;\n112:     }\n113: }\n\n(End of file - total 113 lines)\n</content>",
