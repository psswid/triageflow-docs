ption\n40:      *\n41:      * @return array<string, mixed> Either ['type' => 'question', 'content' => '...']\n42:      *                              or ['type' => 'result', 'specialist' => '...', ...]\n43:      *\n44:      * @throws TriageAnalysisFailedException When the AI call fails at the\n45:      *         transport level (OpenRouterException) or returns a malformed\n46:      *         result-type response\n47:      */\n48:     public function analyzeInitial(string $description): array\n49:     {\n50:         try {\n51:             $messages = $this->prompt->buildConversationContext($description, []);\n52:             $rawResponse = $this->client->chat($messages);\n53: \n54:             return $this->parseAndDiscriminate($rawResponse, 0);\n55:         } catch (OpenRouterException $e) {\n56:             throw new TriageAnalysisFailedException($e->getMessage(), previous: $e);\n57:         }\n58:     }\n59: \n60:     /**\n61:      * Analyse a follow-up answer in the context of an existing conversation.\n62:      *\n63:      * On turn >= 3, injects a force-result instruction before the user's\n64:      * answer to ensure the AI produces a final result. If the AI still\n65:      * returns a question or malformed output at turn >= 3, throws\n66:      * TriageAnalysisFailedException.\n67:      *\n68:      * @param string                                                    $answer             The user's answer to the last AI question\n69:      * @param array<int, array{type: string, content: string, timestamp: string}> $conversationHistory The full conversation history\n70:      * @param int                                                       $currentTurn        The 1-based follow-up turn number (1, 2, or 3)\n71:      *\n72:      * @return array<string, mixed> Either ['type' => 'question', 'content' => '...']\n73:      *                              or ['type' => 'result', 'specialist' => '...', ...]\n74:      *\n75:      * @throws TriageAnalysisFailedException When the AI fails to produce a\n76:      *         valid result on the final turn or the transport layer fails\n77:      */\n78:     public function analyzeFollowUp(string $answer, array $conversationHistory, int $currentTurn): array\n79:     {\n80:         try {\n81:             $messages = $this->prompt->buildConversationContext($answer, $conversationHistory);\n82: \n83:             // On turn >= 3, insert the force-result instruction as a user\n84:             // message immediately before the current user answer (which is\n85:             // always the last element in the returned messages array).\n86:             if ($currentTurn >= 3) {\n87:                 array_splice(\n88:                     $messages,\n89:                     -1,\n90:                     0,\n91:                     [\n92:                         [\n93:                             'role' => 'user',\n94:                             'content' => self::FORCE_RESULT_MESSAGE,\n95:                         ],\n96:                     ],\n97:                 );\n98:             }\n99: \n100:             $rawResponse = $this->client->chat($messages);\n101: \n102:             return $this->parseAndDiscriminate($rawResponse, $currentTurn);\n103:         } catch (OpenRouterException $e) {\n104:             throw new TriageAnalysisFailedException($e->getMessage(), previous: $e);\n105:         }\n106:     }\n107: \n108:     /**\n109:      * Parse the raw AI response string as JSON and discriminate between\n110:      * a follow-up question and a final triage result.\n111:      *\n112:      * Discrimination rules:\n113:      *   - Valid {\"type\":\"question\",\"content\":\"...\"} → question array\n114:      *   - Valid {\"type\":\"result\",\"specialist\":\"...\",\"urgency\":\"...\",\"justification\":\"...\"} → result array\n115:      *   - Malformed JSON on turns < 3 → treated as question (wrap raw text)\n116:      *   - Malformed JSON on turn >= 3 → TriageAnalysisFailedException\n117:      *   - Unknown type (not question/result) → treated as malformed\n118:      *   - Result missing required keys → TriageAnalysisFailedException\n119:      *\n120:      * @param string $rawResponse The raw string returned by the AI\n121:      * @param int    $turn        Current turn number (0 = initial, 1–3 = follow-ups)\n122:      *\n123:      * @return array<string, mixed>\n124:      *\n125:      * @throws TriageAnalysisFailedException\n126:      */\n127:     private function parseAndDiscriminate(string $rawResponse, int $turn): array\n128:     {\n129:         $data = json_decode($rawResponse, true);\n130: \n131:         // ── Malformed JSON ────────────────────────────────────────────\n132:         if (!is_array($data)) {\n133:             if ($turn >= 3) {\n134:                 throw new TriageAnalysisFailedException(\n135:                     'AI returned malformed JSON on the final turn — unable to produce a triage result.',\n136:                 );\n137:             }\n138: \n139:             // Turns 0–2: treat as question, wrapping the raw text\n140:             return ['type' => 'question', 'content' => $rawResponse];\n141:         }\n142: \n143:         $type = (string) ($data['type'] ?? '');\n144: \n145:         // ── Question response ──────────────────────────────────────────\n146:         if ($type === 'question') {\n147:             if ($turn >= 3) {\n148:                 throw new TriageAnalysisFailedException(\n149:                     'AI returned a question on the final turn — non-compliance with the force-result instruction.',\n150:                 );\n151:             }\n152: \n153:             return [\n154:                 'type' => 'question',\n155:                 'content' => (string) ($data['content'] ?? $rawResponse),\n156:             ];\n157:         }\n158: \n159:         // ── Result response ────────────────────────────────────────────\n160:         if ($type === 'result') {\n161:             if (!isset($data['specialist']) || $data['specialist'] === null) {\n162:                 throw new TriageAnalysisFailedException(\n163:                     'AI result is missing required field: specialist.',\n164:                 );\n165:             }\n166: \n167:             if (!isset($data['urgency']) || $data['urgency'] === null) {\n168:                 throw new TriageAnalysisFailedException(\n169:                     'AI result is missing required field: urgency.',\n170:                 );\n171:             }\n172: \n173:             if (!isset($data['justification']) || $data['justification'] === null) {\n174:                 throw new TriageAnalysisFailedException(\n175:                     'AI result is missing required field: justification.',\n176:                 );\n177:             }\n178: \n179:             return [\n180:                 'type' => 'result',\n181:                 'specialist' => (string) $data['specialist'],\n182:                 'urgency' => (string) $data['urgency'],\n183:                 'justification' => (string) $data['justification'],\n184:             ];\n185:         }\n186: \n187:         // ── Unknown type — treat as malformed ──────────────────────────\n188:         if ($turn >= 3) {\n189:             throw new TriageAnalysisFailedException(\n190:                 sprintf(\n191:                     'AI returned unknown response type \"%s\" on the final turn.',\n192:                     $type ?: '(empty)',\n193:                 ),\n194:             );\n195:         }\n196: \n197:         return ['type' => 'question', 'content' => $rawResponse];\n198:     }\n199: }\n\n(End of file - total 199 lines)\n</content>",
