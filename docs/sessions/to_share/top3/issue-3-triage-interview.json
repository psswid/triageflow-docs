n186:     public function testChatRetriesOnTransportException(): void\n187:     {\n188:         $callCount = 0;\n189: \n190:         $httpClient = new MockHttpClient(function () use (&$callCount): MockResponse {\n191:             $callCount++;\n192: \n193:             if ($callCount < 3) {\n194:                 throw new class ('Network error') extends \\Exception implements TransportExceptionInterface {};\n195:             }\n196: \n197:             $responseBody = json_encode([\n198:                 'choices' => [\n199:                     ['message' => ['content' => 'Success after retries']],\n200:                 ],\n201:             ], JSON_THROW_ON_ERROR);\n202: \n203:             return new MockResponse($responseBody, ['http_code' => 200]);\n204:         });\n205: \n206:         $client = $this->createClient($httpClient);\n207:         $result = $client->chat([['role' => 'user', 'content' => 'Hello']]);\n208: \n209:         $this->assertSame('Success after retries', $result);\n210:         $this->assertSame(3, $callCount, 'Expected 3 calls (2 failures + 1 success)');\n211:     }\n212: \n213:     public function testChatThrowsOpenRouterExceptionAfterThreeFailures(): void\n214:     {\n215:         $callCount = 0;\n216: \n217:         $httpClient = new MockHttpClient(function () use (&$callCount): never {\n218:             $callCount++;\n219:             throw new class ('Persistent network error') extends \\Exception implements TransportExceptionInterface {};\n220:         });\n221: \n222:         $client = $this->createClient($httpClient);\n223: \n224:         $this->expectException(OpenRouterException::class);\n225:         $this->expectExceptionMessageMatches('/failed after 3 attempts/i');\n226: \n227:         try {\n228:             $client->chat([['role' => 'user', 'content' => 'Hello']]);\n229:         } finally {\n230:             $this->assertSame(3, $callCount, 'Expected exactly 3 call attempts');\n231:         }\n232:     }\n233: \n234:     public function testChatRetriesOnlyOnTransportExceptionNotHttpErrors(): void\n235:     {\n236:         $callCount = 0;\n237: \n238:         $httpClient = new MockHttpClient(function () use (&$callCount): MockResponse {\n239:             $callCount++;\n240: \n241:             // Return a 500 error with a valid response body structure —\n242:             // NOT a TransportException, so the client should NOT retry.\n243:             // It will attempt toArray() and extract content from the body.\n244:             $responseBody = json_encode([\n245:                 'choices' => [\n246:                     ['message' => ['content' => 'Error response body']],\n247:                 ],\n248:             ], JSON_THROW_ON_ERROR);\n249: \n250:             return new MockResponse($responseBody, ['http_code' => 500]);\n251:         });\n252: \n253:         $client = $this->createClient($httpClient);\n254:         $result = $client->chat([['role' => 'user', 'content' => 'Hello']]);\n255: \n256:         // Key assertion: only 1 call was made — no retry on HTTP errors\n257:         $this->assertSame(1, $callCount, 'Should not retry on HTTP 500 — only TransportException triggers retry');\n258:         $this->assertSame('Error response body', $result);\n259:     }\n260: \n261:     // ─── Class Structure ─────────────────────────────────────────────\n262: \n263:     public function testClassIsFinal(): void\n264:     {\n265:         $reflection = new \\ReflectionClass(OpenRouterClient::class);\n266: \n267:         $this->assertTrue($reflection->isFinal(), 'OpenRouterClient must be a final class');\n268:     }\n269: \n270:     public function testClassIsReadonly(): void\n271:     {\n272:         $reflection = new \\ReflectionClass(OpenRouterClient::class);\n273: \n274:         $this->assertTrue(\n275:             $reflection->isReadOnly(),\n276:             'OpenRouterClient must be a readonly class'\n277:         );\n278:     }\n279: \n280:     public function testFileHasStrictTypes(): void\n281:     {\n282:         $reflection = new \\ReflectionClass(OpenRouterClient::class);\n283:         $filePath = $reflection->getFileName();\n284:         $this->assertIsString($filePath);\n285: \n286:         $fileContents = file_get_contents($filePath);\n287:         $this->assertStringContainsString('declare(strict_types=1)', (string) $fileContents);\n288:     }\n289: \n290:     // ─── Timeout Configuration ───────────────────────────────────────\n291: \n292:     public function testChatIncludesTimeoutInRequest(): void\n293:     {\n294:         $responseBody = json_encode([\n295:             'choices' => [\n296:                 ['message' => ['content' => 'OK']],\n297:             ],\n298:         ], JSON_THROW_ON_ERROR);\n299: \n300:         $httpClient = new MockHttpClient(function (string $method, string $url, array $options) use ($responseBody): MockResponse {\n301:             $this->assertSame(self::TIMEOUT, $options['timeout'] ?? null);\n302: \n303:             return new MockResponse($responseBody, ['http_code' => 200]);\n304:         });\n305: \n306:         $client = $this->createClient($httpClient);\n307:         $client->chat([['role' => 'user', 'content' => 'Hello']]);\n308:     }\n309: }\n\n(End of file - total 309 lines)\n</content>",
