', 'content' => 'How long?', 'timestamp' => '2026-05-30T10:01:00+00:00'],\n261:         ];\n262: \n263:         $result = $analyzer->analyzeFollowUp('Two days', $history, 1);\n264: \n265:         $this->assertSame('question', $result['type']);\n266:         $this->assertSame('Unparseable raw text response', $result['content']);\n267:     }\n268: \n269:     // ─── Malformed JSON on Turn 3 — Throws ────────────────────────────\n270: \n271:     public function testMalformedJsonOnTurn3ThrowsException(): void\n272:     {\n273:         $analyzer = $this->createAnalyzer('Not JSON');\n274: \n275:         $history = [\n276:             ['type' => 'initial_description', 'content' => 'Headache', 'timestamp' => '2026-05-30T10:00:00+00:00'],\n277:             ['type' => 'question', 'content' => 'How long?', 'timestamp' => '2026-05-30T10:01:00+00:00'],\n278:             ['type' => 'answer', 'content' => '2 days', 'timestamp' => '2026-05-30T10:02:00+00:00'],\n279:             ['type' => 'question', 'content' => 'Where?', 'timestamp' => '2026-05-30T10:03:00+00:00'],\n280:             ['type' => 'answer', 'content' => 'Forehead', 'timestamp' => '2026-05-30T10:04:00+00:00'],\n281:             ['type' => 'question', 'content' => 'Nausea?', 'timestamp' => '2026-05-30T10:05:00+00:00'],\n282:         ];\n283: \n284:         $this->expectException(TriageAnalysisFailedException::class);\n285:         $this->expectExceptionMessageMatches('/JSON/i');\n286: \n287:         $analyzer->analyzeFollowUp('Yes', $history, 3);\n288:     }\n289: \n290:     // ─── Unknown JSON Type ────────────────────────────────────────────\n291: \n292:     public function testUnknownTypeInJsonTreatedAsMalformed(): void\n293:     {\n294:         $analyzer = $this->createAnalyzer(\n295:             json_encode(['type' => 'greeting', 'message' => 'Hello!'], JSON_THROW_ON_ERROR),\n296:         );\n297: \n298:         $result = $analyzer->analyzeInitial('Hello');\n299: \n300:         // Unknown type on turn 0 → treated a