     $responseBody = json_encode([\n47:             'choices' => [\n48:                 ['message' => ['content' => 'Test response']],\n49:             ],\n50:         ], JSON_THROW_ON_ERROR);\n51: \n52:         $httpClient = new MockHttpClient(function (string $method, string $url, array $options) use ($responseBody): MockResponse {\n53:             // Assertions inside the callback verify request details\n54:             $this->assertSame('POST', $method);\n55:             $this->assertSame(self::BASE_URL . '/chat/completions', $url);\n56: \n57:             return new MockResponse($responseBody, ['http_code' => 200]);\n58:         });\n59: \n60:         $client = $this->createClient($httpClient);\n61:         $client->chat([['role' => 'user', 'content' => 'Hello']]);\n62:     }\n63: \n64:     public function testChatSendsCorrectHeaders(): void\n65:     {\n66:         $responseBody = json_encode([\n67:             'choices' => [\n68:                 ['message' => ['content' => 'Test response']],\n69:             ],\n70:         ], JSON_THROW_ON_ERROR);\n71: \n72:         $httpClient = new MockHttpClient(function (string $method, string $url, array $options) use ($responseBody): MockResponse {\n73:             $headers = $options['headers'] ?? [];\n74: \n75:             $this->assertSame('Bearer ' . self::API_KEY, $headers['Authorization'] ?? null);\n76:             $this->assertArrayHasKey('HTTP-Referer', $headers);\n77:             $this->assertArrayHasKey('X-Title', $headers);\n78:             $this->assertSame('application/json', $headers['Content-Type'] ?? null);\n79: \n80:             return new MockResponse($responseBody, ['http_code' => 200]);\n81:         });\n82: \n83:         $client = $this->createClient($httpClient);\n84:         $client->chat([['role' => 'user', 'content' => 'Hello']]);\n85:     }\n86: \n87:     public function testChatSendsCorrectBodyWithDefaultModel(): void\n88:     {\n89:         $responseBody = json_encode([\n90:             'choices' => [\n91:                 ['message' => ['content' => 'Test response']],\n92:             ],\n93:         ], JSON_THROW_ON_ERROR);\n94: \n95:         $messages = [['role' => 'user', 'content' => 'Hello']];\n96: \n97:         $httpClient = new MockHttpClient(function (string $method, string $url, array $options) use ($responseBody, $messages): MockResponse {\n98:             // MockHttpClient callable receives raw options — 'json' key, not 'body'\n99:             $json = $options['json'] ?? [];\n100: \n101:             $this->assertSame(self::DEFAULT_MODEL, $json['model']);\n102:             $this->assertSame($messages, $json['messages']);\n103:             $this->assertSame(self::MAX_TOKENS, $json['max_tokens']);\n104:             $this->assertSame(self::TEMPERATURE, $json['temperature']);\n105: \n106:             return new MockResponse($responseBody, ['http_code' => 200]);\n107:         });\n108: \n109:         $client = $this->createClient($httpClient);\n110:         $client->chat($messages);\n111:     }\n112: \n113:     public function testChatUsesProvidedModelWhenSpecified(): void\n114:     {\n115:         $responseBody = json_encode([\n116:             'choices' => [\n117:                 ['message' => ['content' => 'Test response']],\n118:             ],\n119:         ], JSON_THROW_ON_ERROR);\n120: \n121:         $httpClient = new MockHttpClient(function (string $method, string $url, array $options) use ($responseBody): MockResponse {\n122:             $json = $options['json'] ?? [];\n123: \n124:             $this->assertSame('custom-model:free', $json['model']);\n125: \n126:             return new MockResponse($responseBody, ['http_code' => 200]);\n127:         });\n128: \n129:         $client = $this->createClient($httpClient);\n130:         $client->chat([['role' => 'user', 'content' => 'Hello']], 'custom-model:free');\n131:     }\n132: \n133:     // ─── Response Parsing ────────────────────────────────────────────\n134: \n135:     public function test