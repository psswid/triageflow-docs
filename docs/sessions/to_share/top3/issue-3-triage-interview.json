ere?'], JSON_THROW_ON_ERROR),\n94:         );\n95: \n96:         $history = [\n97:             [\n98:                 'type' => 'initial_description',\n99:                 'content' => 'My head hurts',\n100:                 'timestamp' => '2026-05-30T10:00:00+00:00',\n101:             ],\n102:             [\n103:                 'type' => 'question',\n104:                 'content' => 'How long have you had this pain?',\n105:                 'timestamp' => '2026-05-30T10:01:00+00:00',\n106:             ],\n107:         ];\n108: \n109:         $result = $analyzer->analyzeFollowUp('Since yesterday', $history, 1);\n110: \n111:         $this->assertSame('question', $result['type']);\n112:         $this->assertSame('Does the pain radiate anywhere?', $result['content']);\n113:     }\n114: \n115:     public function testAnalyzeFollowUpReturnsValidResult(): void\n116:     {\n117:         $analyzer = $this->createAnalyzer(\n118:             json_encode([\n119:                 'type' => 'result',\n120:                 'specialist' => 'CARDIOLOGIST',\n121:                 'urgency' => 'EMERGENCY',\n122:                 'justification' => 'Chest pain radiating to left arm with shortness of breath.',\n123:             ], JSON_THROW_ON_ERROR),\n124:         );\n125: \n126:         $history = [\n127:             [\n128:                 'type' => 'initial_description',\n129:                 'content' => 'I have chest pain',\n130:                 'timestamp' => '2026-05-30T10:00:00+00:00',\n131:             ],\n132:             [\n133:                 'type' => 'question',\n134:                 'content' => 'Does the pain radiate?',\n135:                 'timestamp' => '2026-05-30T10:01:00+00:00',\n136:             ],\n137:             [\n138:                 'type' => 'answer',\n139:                 'content' => 'Yes, to my left arm',\n140:                 'timestamp' => '2026-05-30T10:02:00+00:00',\n141:             ],\n142:         ];\n143: \n144:         $result = $analyzer->ana