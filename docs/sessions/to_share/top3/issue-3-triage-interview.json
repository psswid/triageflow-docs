eption(\n45:                 sprintf(\n46:                     'Triage Submission not found for ID \"%s\".',\n47:                     $message->submissionId->toRfc4122(),\n48:                 ),\n49:             );\n50:         }\n51: \n52:         // No-op: already in a terminal state\n53:         if ($submission->getStatus() === TriageStatus::Completed\n54:             || $submission->getStatus() === TriageStatus::Failed) {\n55:             return;\n56:         }\n57: \n58:         // No-op: Pending submission has only the initial description — nothing to process\n59:         if ($submission->getStatus() === TriageStatus::Pending) {\n60:             return;\n61:         }\n62: \n63:         // Extract the last user answer from the conversation history.\n64:         $answerContent = $this->extractLastAnswer($submission->getConversationHistory());\n65:         if ($answerContent === null) {\n66:             // AwaitingAnswer with no answer yet (e.g., dispatched from initial submit)\n67:             return;\n68:         }\n69: \n70:         try {\n71:             $result = $this->analyzer->analyzeFollowUp(\n72:                 $answerContent,\n73:                 $submission->getConversationHistory(),\n74:                 $submission->getCurrentTurn(),\n75:             );\n76:         } catch (TriageAnalysisFailedException) {\n77:             $submission->markFailed();\n78:             $this->entityManager->flush();\n79: \n80:             return;\n81:         }\n82: \n83:         if ($result['type'] === 'result') {\n84:             $outcome = TriageOutcome::create(\n85:                 specialist: $result['specialist'],\n86:                 urgency: $result['urgency'],\n87:                 justification: $result['justification'],\n88:             );\n89:             $submission->completeWithOutcome($outcome);\n90:         } else {\n91:             $submission->addAiQuestion($result['content']);\n92:         }\n93: \n94:         $this->entityManager->flush();\n95:     }\n96: \n97:     /**\n98:      * Scan the conversation history backwards for the most recent\n99:      * answer entry and return its content, or null if none found.\n100:      *\n101:      * @param array<int, array{type: string, content: string, timestamp: string}> $history\n102:      */\n103:     private function extractLastAnswer(array $history): ?string\n104:     {\n105:         for ($i = count($history) - 1; $i >= 0; $i--) {\n106:             if ($history[$i]['type'] === 'answer') {\n107:                 return $history[$i]['content'];\n108:             }\n109:         }\n110: \n111:         return null;\n112:     }\n113: }\n\n(End of file - total 113 lines)\n</content>",
