tion if required keys are missing\n53:      */\n54:     public static function fromAiResult(array $data): self\n55:     {\n56:         if (!isset($data['specialist'])) {\n57:             throw new \\InvalidArgumentException('Missing required field \"specialist\" in AI result data.');\n58:         }\n59: \n60:         if (!isset($data['urgency'])) {\n61:             throw new \\InvalidArgumentException('Missing required field \"urgency\" in AI result data.');\n62:         }\n63: \n64:         if (!isset($data['justification'])) {\n65:             throw new \\InvalidArgumentException('Missing required field \"justification\" in AI result data.');\n66:         }\n67: \n68:         return self::create(\n69:             specialist: (string) $data['specialist'],\n70:             urgency: (string) $data['urgency'],\n71:             justification: (string) $data['justification'],\n72:         );\n73:     }\n74: \n75:     public function getSpecialist(): string\n76:     {\n77:         return $this->specialist;\n78:     }\n79: \n80:     public function getUrgency(): string\n81:     {\n82:         return $this->urgency;\n83:     }\n84: \n85:     public function getJustification(): string\n86:     {\n87:         return $this->justification;\n88:     }\n89: \n90:     /**\n91:      * Always true — a TriageOutcome only exists when the result is complete.\n92:      * Null/no-result is represented by ?TriageOutcome = null on the parent entity.\n93:      */\n94:     public function isComplete(): bool\n95:     {\n96:         return true;\n97:     }\n98: \n99:     /**\n100:      * Value object equality — two outcomes are equal when\n101:      * all three fields match.\n102:      */\n103:     public function equals(self $other): bool\n104:     {\n105:         return $this->specialist === $other->specialist\n106:             && $this->urgency === $other->urgency\n107:             && $this->justification === $other->justification;\n108:     }\n109: }\n\n(End of file - total 109 lines)\n</