string}>\n86:      *         The complete messages array for the AI model\n87:      *\n88:      * @throws \\InvalidArgumentException if a history entry has an unrecognized type\n89:      */\n90:     public function buildConversationContext(string $userMessage, array $history): array\n91:     {\n92:         $messages = [];\n93: \n94:         // 1. System prompt — sets the AI's behavior and constraints\n95:         $messages[] = [\n96:             'role' => 'system',\n97:             'content' => $this->getSystemMessage(),\n98:         ];\n99: \n100:         // 2. Map each conversation history entry to its OpenAI role\n101:         foreach ($history as $entry) {\n102:             $messages[] = [\n103:                 'role' => self::mapHistoryTypeToRole($entry['type']),\n104:                 'content' => $entry['content'],\n105:             ];\n106:         }\n107: \n108:         // 3. Current user message — always the last entry\n109:         $messages[] = [\n110:             'role' => 'user',\n111:             'content' => $userMessage,\n112:         ];\n113: \n114:         return $messages;\n115:     }\n116: \n117:     /**\n118:      * Maps a conversation history entry 'type' value to an OpenAI message 'role'.\n119:      *\n120:      * @throws \\InvalidArgumentException when the type is not one of the recognized values\n121:      */\n122:     private static function mapHistoryTypeToRole(string $type): string\n123:     {\n124:         return match ($type) {\n125:             'initial_description', 'answer' => 'user',\n126:             'question', 'result' => 'assistant',\n127:             default => throw new \\InvalidArgumentException(\n128:                 sprintf('Unknown conversation history entry type: \"%s\".', $type),\n129:             ),\n130:         };\n131:     }\n132: }\n\n(End of file - total 132 lines)\n</content>",
