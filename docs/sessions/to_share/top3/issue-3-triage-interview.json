e description exceeds 500 characters\n43:      */\n44:     public function __invoke(SubmitTriageCommand $command): TriageSubmission\n45:     {\n46:         $this->validateDescription($command->initialDescription);\n47: \n48:         $submission = TriageSubmission::submit($command->user, $command->initialDescription);\n49: \n50:         // Persist before AI call so the submission exists in the database\n51:         // even if the AI call takes time or fails.\n52:         $this->repository->save($submission);\n53: \n54:         try {\n55:             $result = $this->analyzer->analyzeInitial($command->initialDescription);\n56:         } catch (TriageAnalysisFailedException) {\n57:             $submission->markFailed();\n58:             $this->entityManager->flush();\n59: \n60:             return $submission;\n61:         }\n62: \n63:         if ($result['type'] === 'result') {\n64:             $outcome = TriageOutcome::create(\n65:                 specialist: $result['specialist'],\n66:                 urgency: $result['urgency'],\n67:                 justification: $result['justification'],\n68:             );\n69:             $submission->completeWithOutcome($outcome);\n70:             $this->entityManager->flush();\n71:         } else {\n72:             // AI returned a follow-up question — record it and dispatch\n73:             // async processing for subsequent answers.\n74:             $submission->addAiQuestion($result['content']);\n75:             $this->entityManager->flush();\n76: \n77:             $this->messageBus?->dispatch(\n78:                 new ProcessTriageMessage($submission->getId()),\n79:             );\n80:         }\n81: \n82:         return $submission;\n83:     }\n84: \n85:     /**\n86:      * @throws \\InvalidArgumentException When the description exceeds the character limit\n87:      */\n88:     private function validateDescription(string $description): void\n89:     {\n90:         if (mb_strlen($description) > self::MAX_DESCRIPTION_LENGTH