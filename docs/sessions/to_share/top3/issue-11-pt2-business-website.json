its.items():\n        s = audit.get('score')\n        if s is not None and s < 1:\n            title = audit.get('title', audit_id)\n            failing.append(title)\n    \n    print(f\"=== {name} (Score: {score}) ===\")\n    if failing:\n        for f_item in sorted(failing):\n            print(f\"  ✗ {f_item}\")\n    else:\n        print(\"  ✅ No failing audits\")\n    print()\n\nPYEOF",
