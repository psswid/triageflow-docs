apper });\n    expect(screen.getByRole('heading', { level: 1 })).toBeTruthy();\n  });\n\n  it('renders 4 step cards', () => {\n    render(<HowItWorksPage />, { wrapper });\n    const steps = screen.getAllByRole('heading', { level: 3 });\n    expect(steps.length).toBe(4);\n  });\n\n  it('renders CTA link to triage', () => {\n    render(<HowItWorksPage />, { wrapper });\n    const cta = screen.getByRole('link', { name: /try/i });\n    expect(cta.getAttribute('href')).toBe('/triage');\n  });\n\n  it('renders demo disclaimer', () => {\n    render(<HowItWorksPage />, { wrapper });\n    expect(screen.getByText(/demonstrat/i)).toBeTruthy();\n  });\n});\n```\n\n**IMPORTANT:** Before creating test files, check what testing patterns existing tests use. Look at `frontend/src/test/marketing/PrivacyPage.test.tsx` for the marketing page test pattern, and `frontend/src/test/shared/DarkModeToggle.test.tsx` for the shared component test pattern. Match the imports and wrapper style of existing tests.\n\nAlso check: `frontend/src/test/marketing/AboutPage.test.tsx` for the HelmetProvider pattern.\n\n---\n\n### Verification:\nAfter all fixes, run:\n- Backend: `php -l /home/stefan/dev/projects/triageflow/backend/src/User/Infrastructure/Controller/RegistrationController.php`\n- Frontend: `cd /home/stefan/dev/projects/triageflow/frontend && npx tsc --noEmit` — must be clean\n- Frontend: `cd /home/stefan/dev/projects/triageflow/frontend && npx vitest run` — target: all tests pass (more than 136 now)\n- Frontend: `cd /home/stefan/dev/projects/triageflow/frontend && npx eslint src/ 2>&1 | tail -3` — exit 0\n\nReturn a report of every file created/modified and verification results.",
